# VITE_API_BASE_URL: base URL of the eygn-api backend, including its /api/v1 path. Leave unset
# for local dev -- it then dynamically follows whatever host this page was loaded from (so it
# keeps working across localhost, 127.0.0.1, and a LAN IP when opened from a phone; see
# src/lib/api.ts). Only set this for a real deployment where the API lives on a different host
# than this site, e.g. VITE_API_BASE_URL="https://api.ethiopianyouthglobalnetwork.org/api/v1".
VITE_API_BASE_URL=""

# VITE_SITE_URL: this site's own real production origin, used to build canonical URLs and
# OG/Twitter image URLs (src/lib/siteConfig.ts, F13). Falls back to
# https://ethiopianyouthglobalnetwork.org (the domain already used in the brief and this app's
# own official email addresses) when unset -- confirm this is the actual deployed hostname
# before launch. Note: public/robots.txt and public/sitemap.xml are static files and hardcode
# that same fallback domain directly; update them too if the real domain differs.
VITE_SITE_URL="https://ethiopianyouthglobalnetwork.org"

# VITE_SOCIAL_*: real social media profile URLs (F11, brief must-have: "social media links and
# sharing"). Each is entirely optional -- Footer/ContactPage only show an icon for the ones set.
# Leave unset (or delete the line) for any platform EYGN doesn't have yet.
VITE_SOCIAL_FACEBOOK=""
VITE_SOCIAL_TWITTER=""
VITE_SOCIAL_INSTAGRAM=""
VITE_SOCIAL_LINKEDIN=""
VITE_SOCIAL_YOUTUBE=""
VITE_SOCIAL_TELEGRAM=""

# VITE_GA_MEASUREMENT_ID: Google Analytics 4 measurement id (starts with "G-", launch checklist
# item, F15). Leave unset to skip loading Analytics entirely -- see src/lib/analytics.ts.
VITE_GA_MEASUREMENT_ID=""
