# VITE_API_BASE_URL: base URL of the eygn-api backend, including its /api/v1 path.
# Falls back to http://localhost:8080/api/v1 (src/lib/api.ts) when unset.
VITE_API_BASE_URL="http://localhost:8080/api/v1"

# VITE_SITE_URL: this site's own real production origin, used to build canonical URLs and
# OG/Twitter image URLs (src/lib/siteConfig.ts, F13). Falls back to
# https://ethiopianyouthglobalnetwork.org (the domain already used in the brief and this app's
# own official email addresses) when unset -- confirm this is the actual deployed hostname
# before launch. Note: public/robots.txt and public/sitemap.xml are static files and hardcode
# that same fallback domain directly; update them too if the real domain differs.
VITE_SITE_URL="https://ethiopianyouthglobalnetwork.org"
